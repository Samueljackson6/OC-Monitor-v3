[Unit]
Description=OC-Monitor API Server
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/oc-monitor/api
Environment="PATH=/opt/oc-monitor/venv/bin"
EnvironmentFile=/opt/oc-monitor/deploy/.env.production
ExecStart=/opt/oc-monitor/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=10
StandardOutput=append:/var/log/oc-monitor/api.log
StandardError=append:/var/log/oc-monitor/api-error.log

[Install]
WantedBy=multi-user.target
