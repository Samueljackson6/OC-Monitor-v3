[Unit]
Description=OC-Monitor API Server
After=network.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/oc-monitor/api
Environment="PATH=/opt/oc-monitor/venv/bin"
EnvironmentFile=/opt/oc-monitor/shared/.env
ExecStart=/opt/oc-monitor/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=10
StandardOutput=append:/var/log/oc-monitor/api.log
StandardError=append:/var/log/oc-monitor/api-error.log

[Install]
WantedBy=multi-user.target
