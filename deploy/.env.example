ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_DIR=/var/log/oc-monitor
DATABASE_URL=postgresql+asyncpg://oc_monitor:CHANGE_ME@127.0.0.1:5432/oc_monitor
REDIS_URL=redis://127.0.0.1:6379/0
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
INGEST_TOKEN=CHANGE_ME_COLLECTOR_TOKEN
CORS_ORIGINS=https://your-domain.example
OC_MONITOR_ENDPOINT=http://127.0.0.1:8000
OPENCLAW_GATEWAY_PORT=18789
OC_MONITOR_BATCH_SIZE=10
OC_MONITOR_BATCH_WINDOW=5
DATA_RETENTION_DAYS=30
RESOLVED_ALERT_RETENTION_DAYS=30
