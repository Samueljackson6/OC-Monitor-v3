# OC-Monitor v3.0 生产环境配置

# 应用配置
APP_NAME=OC-Monitor
APP_VERSION=3.0.0
DEBUG=false

# API 配置
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# 数据库配置（生产环境使用 PostgreSQL）
DATABASE_URL=postgresql+asyncpg://ocmonitor:password@localhost:5432/ocmonitor

# JWT 配置
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 初始管理员账户
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=/var/log/oc-monitor

# 采集端配置
COLLECTOR_INTERVAL_MIN=5
COLLECTOR_INTERVAL_MAX=60
PUSH_API_URL=http://localhost:8000/api/v1/metrics/batch
BATCH_SIZE=10
BATCH_TIMEOUT=5

# 告警配置
ALERT_CPU_THRESHOLD=80
ALERT_MEMORY_THRESHOLD=85
ALERT_DISK_THRESHOLD=90
